{
  "info": {
    "_postman_id": "a9d7f514-64b2-4e82-9a19-8a391c074b21",
    "name": "Rick and Morty Explorer API - Portfolio Collection",
    "description": "Coleção completa para testar tanto a API Pública oficial de Rick and Morty (`{{publicbaseurl}}`) quanto a API própria `rick-and-morty-explorer-api` (`{{localbaseurl}}`), incluindo paginação, filtros, favoritos em SQLite, episódios favoritos, estatísticas com Pandas e cenários de erro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "publicbaseurl",
      "value": "https://rickandmortyapi.com/api",
      "type": "string"
    },
    {
      "key": "localbaseurl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. API Publica",
      "description": "Consultas diretas à API pública oficial de Rick and Morty (`{{publicbaseurl}}`) para inspeção dos recursos de leitura, paginação e filtros nativos.",
      "item": [
        {
          "name": "Listar Personagens (Paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contains pagination info and results array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('info');",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{publicbaseurl}}/character?page=1",
              "host": [
                "{{publicbaseurl}}"
              ],
              "path": [
                "character"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Página da listagem (20 itens por página)"
                }
              ]
            },
            "description": "Lista personagens diretamente da API pública de Rick and Morty respeitando a paginação."
          },
          "response": []
        },
        {
          "name": "Buscar Personagem por ID (Rick Sanchez)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Character ID is 1', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{publicbaseurl}}/character/1",
              "host": [
                "{{publicbaseurl}}"
              ],
              "path": [
                "character",
                "1"
              ]
            },
            "description": "Busca os detalhes completos do personagem de ID 1 (Rick Sanchez) na API pública."
          },
          "response": []
        },
        {
          "name": "Filtrar Personagens (Nome, Status e Espécie)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{publicbaseurl}}/character/?name=rick&status=alive&species=Human",
              "host": [
                "{{publicbaseurl}}"
              ],
              "path": [
                "character",
                ""
              ],
              "query": [
                {
                  "key": "name",
                  "value": "rick"
                },
                {
                  "key": "status",
                  "value": "alive"
                },
                {
                  "key": "species",
                  "value": "Human"
                }
              ]
            },
            "description": "Filtra personagens na API pública combinando nome, status e espécie."
          },
          "response": []
        },
        {
          "name": "Listar Episódios da API Pública",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{publicbaseurl}}/episode?page=1",
              "host": [
                "{{publicbaseurl}}"
              ],
              "path": [
                "episode"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Lista os episódios disponíveis na API pública de Rick and Morty."
          },
          "response": []
        },
        {
          "name": "Exemplo de Erro 404 na API Pública",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
