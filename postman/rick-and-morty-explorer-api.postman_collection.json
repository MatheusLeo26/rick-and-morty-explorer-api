            "description": "Demonstra o retorno 404 nativo da API pública ao buscar um ID inexistente."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Minha API (Rick and Morty Explorer)",
      "description": "Fluxos completos da API local (`{{localbaseurl}}`): listagem paginada com cache, filtros, adição/listagem/remoção de favoritos em SQLite, episódios favoritos, estatísticas com Pandas e tratamento padronizado de erros.",
      "item": [
        {
          "name": "Healthcheck da API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{localbaseurl}}/api/health/",
              "host": [
                "{{localbaseurl}}"
              ],
              "path": [
                "api",
                "health",
                ""
              ]
            },
            "description": "Verifica se a API local está ativa e exibe as configurações de cache e URL base externa."
          },
          "response": []
        },
        {
          "name": "Listar Personagens (Paginado + Cache)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response includes info, from_cache and results', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('info');",
                  "    pm.expect(jsonData).to.have.property('from_cache');",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{localbaseurl}}/api/characters/?page=1",
              "host": [
                "{{localbaseurl}}"
              ],
              "path": [
                "api",
                "characters",
                ""
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Lista personagens consumindo a API pública com suporte a cache configurável e indicação de `is_favorite`."
          },
          "response": []
