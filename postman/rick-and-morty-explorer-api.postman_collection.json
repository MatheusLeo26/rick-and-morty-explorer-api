        {
          "name": "Filtrar Personagens por Nome, Status e Espécie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{localbaseurl}}/api/characters/?name=rick&status=alive&species=Human&page=1",
              "host": [
                "{{localbaseurl}}"
              ],
              "path": [
                "api",
                "characters",
                ""
              ],
              "query": [
                {
                  "key": "name",
                  "value": "rick"
                },
                {
                  "key": "status",
                  "value": "alive"
                },
                {
                  "key": "species",
                  "value": "Human"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Filtra personagens na API local por `name`, `status` (`alive`, `dead`, `unknown`) e `species`."
          },
          "response": []
        },
        {
          "name": "Buscar Personagem pelo ID (Com Fallback Offline)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{localbaseurl}}/api/characters/1/",
              "host": [
                "{{localbaseurl}}"
              ],
              "path": [
                "api",
                "characters",
                "1",
                ""
              ]
            },
            "description": "Busca um personagem pelo ID. Caso a API pública esteja indisponível e o personagem esteja salvo nos favoritos locais (SQLite), retorna seus dados essenciais via fallback local."
          },
          "response": []
        },
        {
          "name": "Adicionar um Favorito (Rick Sanchez #1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Saved external_id is 1', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.external_id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"character_id\": 1,\n  \"notes\": \"Cientista genial da dimensão C-137\"\n}"
